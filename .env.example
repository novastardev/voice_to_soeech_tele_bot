# ============================================================
# 🔊 Voice to Speech Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then edit .env with your actual values

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram. Get the API token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- TTS API ---
# Your TTS.ai API key (or whichever TTS service you use)
TTS_API_KEY=your_tts_api_key_here

# --- Access Control ---
# JSON array of allowed Telegram Chat IDs.
# Users must be added here before they can use the bot.
# Find a user's Chat ID by sending /start to your bot and
# checking the logs, or by talking to @userinfobot on Telegram.
ALLOWED_CHAT_IDS=[123456789, 987654321]

# --- Bot Owner ---
# Your Telegram username — shown in "Access Denied" messages.
BOT_OWNER_HANDLE=@novastardev
