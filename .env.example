# Telegram Bot Token
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# TTS API Key
# Get this from your TTS service provider
TTS_API_KEY=your-tts-api-key-here

# Allowed Chat IDs (JSON array format)
# Only users with these IDs can use the bot
# Example: [123456789, 987654321, 555666777]
# To get your chat ID, send a message to @userinfobot
ALLOWED_CHAT_IDS=[YOUR_CHAT_ID_HERE]

# Bot Owner Handle (for access denied messages)
# This is the Telegram handle people should contact for access
BOT_OWNER_HANDLE=@your-telegram-handle
